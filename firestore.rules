rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'dsslatur10@gmail.com';
    }

    function isValidQuoteRequest(data) {
      return data.userId is string &&
             data.userId.size() > 0 &&
             data.userId.size() <= 128 &&
             data.category in ['CAR', 'TWO_WHEELER', 'INVERTER', 'COMMERCIAL'] &&
             data.vehicleOrSystem is string &&
             data.vehicleOrSystem.size() >= 2 &&
             data.vehicleOrSystem.size() <= 80 &&
             data.selectedBatteryModel is string &&
             data.selectedBatteryModel.size() >= 2 &&
             data.selectedBatteryModel.size() <= 80 &&
             data.customerName is string &&
             data.customerName.size() >= 2 &&
             data.customerName.size() <= 60 &&
             data.phoneNumber is string &&
             data.phoneNumber.size() >= 10 &&
             data.phoneNumber.size() <= 16 &&
             data.exchangeOldBattery is bool &&
             data.doorstepService is bool &&
             data.locationArea is string &&
             data.locationArea.size() <= 80 &&
             data.estimatedPriceInr is int &&
             data.estimatedPriceInr >= 0 &&
             data.estimatedPriceInr <= 500000 &&
             data.status in ['PENDING', 'CONFIRMED', 'COMPLETED', 'CANCELLED'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidServiceBooking(data) {
      return data.userId is string &&
             data.userId.size() > 0 &&
             data.userId.size() <= 128 &&
             data.serviceType in ['FREE_HEALTH_CHECK', 'DOORSTEP_JUMPSTART', 'ALTERNATOR_TEST', 'HOME_INSTALLATION'] &&
             data.vehicleDetails is string &&
             data.vehicleDetails.size() >= 2 &&
             data.vehicleDetails.size() <= 100 &&
             data.customerName is string &&
             data.customerName.size() >= 2 &&
             data.customerName.size() <= 60 &&
             data.phoneNumber is string &&
             data.phoneNumber.size() >= 10 &&
             data.phoneNumber.size() <= 16 &&
             data.preferredSlot is string &&
             data.preferredSlot.size() >= 3 &&
             data.preferredSlot.size() <= 60 &&
             data.status in ['SCHEDULED', 'CONFIRMED', 'COMPLETED', 'CANCELLED'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    // Collection group read access strictly for verified owner admin (dsslatur10@gmail.com)
    match /{path=**}/quote_requests/{quoteId} {
      allow get, list: if isAdmin();
    }

    match /{path=**}/service_bookings/{bookingId} {
      allow get, list: if isAdmin();
    }

    match /users/{userId}/quote_requests/{quoteId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(quoteId);
      allow list: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) &&
                       isValidId(quoteId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'category', 'vehicleOrSystem', 'selectedBatteryModel',
                         'customerName', 'phoneNumber', 'exchangeOldBattery', 'doorstepService',
                         'locationArea', 'estimatedPriceInr', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'category', 'vehicleOrSystem', 'selectedBatteryModel',
                         'customerName', 'phoneNumber', 'exchangeOldBattery', 'doorstepService',
                         'locationArea', 'estimatedPriceInr', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().status == 'PENDING' &&
                       isValidQuoteRequest(incoming());

      allow update: if isSignedIn() &&
                       isValidId(quoteId) &&
                       isValidQuoteRequest(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'estimatedPriceInr', 'updatedAt'
                          ])) ||
                         (isOwner(userId) &&
                          existing().status != 'COMPLETED' &&
                          existing().status != 'CANCELLED' &&
                          (
                            (incoming().status == 'CANCELLED' &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                            (incoming().status == existing().status &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'vehicleOrSystem', 'locationArea', 'exchangeOldBattery', 'doorstepService', 'updatedAt'
                             ]))
                          ))
                       );

      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(quoteId);
    }

    match /users/{userId}/service_bookings/{bookingId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(bookingId);
      allow list: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId) &&
                       isValidId(bookingId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'serviceType', 'vehicleDetails', 'customerName',
                         'phoneNumber', 'preferredSlot', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'serviceType', 'vehicleDetails', 'customerName',
                         'phoneNumber', 'preferredSlot', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().status == 'SCHEDULED' &&
                       isValidServiceBooking(incoming());

      allow update: if isSignedIn() &&
                       isValidId(bookingId) &&
                       isValidServiceBooking(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'preferredSlot', 'updatedAt'
                          ])) ||
                         (isOwner(userId) &&
                          existing().status != 'COMPLETED' &&
                          existing().status != 'CANCELLED' &&
                          (
                            (incoming().status == 'CANCELLED' &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                            (incoming().status == existing().status &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'preferredSlot', 'vehicleDetails', 'updatedAt'
                             ]))
                          ))
                       );

      allow delete: if (isOwner(userId) || isAdmin()) && isValidId(bookingId);
    }
  }
}
